<extension xmlns="http://ns.adobe.com/air/extension/33.1">
	<id>com.distriqt.Firebase</id>
	<versionNumber>9.0.2</versionNumber>
	<platforms>

		<platform name="Android-ARM">
			<applicationDeployment>
				<nativeLibrary>com.distriqt.firebase.android.jar</nativeLibrary>
				<initializer>com.distriqt.extension.firebase.FirebaseExtension</initializer>
				<finalizer>com.distriqt.extension.firebase.FirebaseExtension</finalizer>
			</applicationDeployment>
		</platform>
		<platform name="Android-ARM64">
			<applicationDeployment>
				<nativeLibrary>com.distriqt.firebase.android.jar</nativeLibrary>
				<initializer>com.distriqt.extension.firebase.FirebaseExtension</initializer>
				<finalizer>com.distriqt.extension.firebase.FirebaseExtension</finalizer>
			</applicationDeployment>
		</platform>
		<platform name="Android-x86">
			<applicationDeployment>
				<nativeLibrary>com.distriqt.firebase.android.jar</nativeLibrary>
				<initializer>com.distriqt.extension.firebase.FirebaseExtension</initializer>
				<finalizer>com.distriqt.extension.firebase.FirebaseExtension</finalizer>
			</applicationDeployment>
		</platform>
		<platform name="Android-x64">
			<applicationDeployment>
				<nativeLibrary>com.distriqt.firebase.android.jar</nativeLibrary>
				<initializer>com.distriqt.extension.firebase.FirebaseExtension</initializer>
				<finalizer>com.distriqt.extension.firebase.FirebaseExtension</finalizer>
			</applicationDeployment>
		</platform>

		<platform name="iPhone-ARM">
			<applicationDeployment>
				<nativeLibrary>libFirebase.a</nativeLibrary>
				<initializer>FirebaseExtInitializer</initializer>
				<finalizer>FirebaseExtFinalizer</finalizer>
			</applicationDeployment>
		</platform>
		<platform name="iPhone-x86">
			<applicationDeployment>
				<nativeLibrary>libFirebase.a</nativeLibrary>
				<initializer>FirebaseExtInitializer</initializer>
				<finalizer>FirebaseExtFinalizer</finalizer>
			</applicationDeployment>
		</platform>

		<platform name="default"> 
			<applicationDeployment /> 
		</platform>
		
	</platforms>
</extension>

